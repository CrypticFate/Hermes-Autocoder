# Placeholders only. Each value belongs in its own git-ignored secrets/<name> file (mode 0600).
# `hc secrets init --dir secrets` generates the random ones; you supply github_bot and model_provider.
github_bot=<BOT_FINE_GRAINED_PAT>              # controller only
model_provider=<OPENROUTER_API_KEY>            # model-proxy only
postgres_password=<POSTGRES_SUPERUSER_PASSWORD> # database only (generated)
db_autocoder_password=<AUTOCODER_ROLE_PASSWORD> # database, controller, model-proxy (generated)
db_mem0_password=<MEM0_ROLE_PASSWORD>           # database, concierge (generated)
mcp_concierge_token=<MCP_BEARER_TOKEN>          # controller, concierge (generated)
concierge_model_token=<CONCIERGE_MODEL_TOKEN>   # concierge; only its hash is stored in the database (generated)
# Optional App mode: mount only into the controller via a local override.
github_app_private_key=<GITHUB_APP_PEM_PRIVATE_KEY>
# Optional Telegram gateway: mount only into the concierge via a local override.
telegram_bot_token=<TELEGRAM_BOT_TOKEN>
