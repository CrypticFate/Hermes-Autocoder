# Compose variables only. Credentials never go here; each lives in its own secrets/<name> file.
AUTOCODER_DATA_DIR=/var/lib/hermes-autocoder
# Must equal model.model in config.yaml (the proxy rejects any other model).
AUTOCODER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Optional Telegram chat (docs/TELEGRAM.md): your numeric Telegram user id, the override file, and how
# often new notifications are pushed to you.
TELEGRAM_ALLOWED_USERS=
# COMPOSE_FILE=compose.yaml:compose.telegram.yaml
NOTIFY_INTERVAL=2m
